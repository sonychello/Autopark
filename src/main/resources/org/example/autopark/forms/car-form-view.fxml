<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.ComboBox?>
<AnchorPane prefHeight="80.0"
            prefWidth="624.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.autopark.client.forms.CarFormViewController"
            stylesheets="@../css/app.css">
   <children>
      <HBox alignment="TOP_CENTER" prefHeight="50.0" prefWidth="624.0" spacing="10.0">
         <children>
             <TextField fx:id="numberField" promptText="Number" />
             <TextField fx:id="colorField" promptText="Color" />
            <ComboBox fx:id="markComboBox"
                      prefWidth="120.0"
                      promptText="Mark" />
             <TextField fx:id="personnelIdField" promptText="Personnel id" />
         </children>
         <padding>
            <Insets left="15.0" right="15.0" top="15.0" />
         </padding>
      </HBox>
      <HBox alignment="BOTTOM_RIGHT" layoutY="52.0" prefHeight="43.0" prefWidth="624.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onSaveClick" prefHeight="26.0" prefWidth="54.0" text="Save" />
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="15.0" right="15.0" />
         </padding>
      </HBox>
   </children>
</AnchorPane>
