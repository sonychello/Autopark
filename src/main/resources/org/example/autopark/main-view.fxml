<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.autopark.client.MainViewController">
   <children>
      <BorderPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <top>
            <MenuBar prefHeight="36.0" prefWidth="559.0" BorderPane.alignment="CENTER">
              <menus>
                <Menu mnemonicParsing="false" text="Справочники">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onCarClick" text="Автомобили" />
                        <MenuItem mnemonicParsing="false" onAction="#onRoutesClick" text="Маршруты" />
                        <MenuItem mnemonicParsing="false" onAction="#onPersonnelClick" text="Персонал" />
                     </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Журналы">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onJournalClick" text="Журнал оператора" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Отчёты">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onRecordsClick" text="Рекорды маршрутов" />
                        <MenuItem mnemonicParsing="false" onAction="#onCarInRoutClick" text="Автомобили в рейсе" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
         </top>
         <center>
            <Label alignment="CENTER" text="Welcom to autopark" BorderPane.alignment="CENTER">
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
