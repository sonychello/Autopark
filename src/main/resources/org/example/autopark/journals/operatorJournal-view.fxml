<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.autopark.client.journalsControllers.OperatorJournalViewController">

    <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <top>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" prefHeight="37.0" prefWidth="600.0" text="Operator's journal" textAlignment="CENTER" textFill="#007641" BorderPane.alignment="CENTER">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </top>
        <center>
            <TableView fx:id="journalTable" minWidth="500.0" BorderPane.alignment="CENTER">
                <columns>
                    <TableColumn fx:id="idColumn" minWidth="2.0" prefWidth="-1.0" text="Id" />
                    <TableColumn fx:id="timeOutColumn" prefWidth="-1.0" text="Time out" />
                    <TableColumn fx:id="timeInColumn" prefWidth="-1.0" text="Time in" />
                    <TableColumn fx:id="autoIdColumn" prefWidth="-1.0" text="Auto id" />
                    <TableColumn fx:id="routeIdColumn" prefWidth="-1.0" text="Route id" />
                </columns>
                <BorderPane.margin>
                    <Insets left="30.0" right="30.0" top="5.0" />
                </BorderPane.margin>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
        </center>
        <bottom>
            <HBox alignment="CENTER" prefHeight="70.0" prefWidth="600.0" spacing="40.0" BorderPane.alignment="CENTER">
                <children>
                    <Button fx:id="sendButton" mnemonicParsing="false" prefHeight="20.0" text="Send off a car" onAction="#onSendOffClick"/>
                    <Button fx:id="timeButton" mnemonicParsing="false" prefHeight="20.0" text="Set the time in" onAction="#onSetTimeInClick"/>
                </children>
            </HBox>
        </bottom>
    </BorderPane>

</AnchorPane>
