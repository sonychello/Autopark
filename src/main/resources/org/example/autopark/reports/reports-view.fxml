<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.autopark.client.ReportsControllers.ReportsViewController">

   <children>
      <VBox alignment="CENTER" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <children>
            <Label fx:id="label" alignment="CENTER" contentDisplay="CENTER" maxHeight="55.0" prefHeight="55.0" VBox.vgrow="NEVER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>

            <BorderPane VBox.vgrow="ALWAYS">

               <top>
                  <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="CENTER">
                     <children>
                        <TextField fx:id="routeNameField" prefHeight="34.0" prefWidth="520.0" promptText="Route name" />

                        <Button mnemonicParsing="false" onAction="#onGenerateClick" text="Generate Report" />
                     </children>

                     <padding>
                        <Insets left="40.0" right="40.0" top="5.0" />
                     </padding>
                  </VBox>
               </top>

               <bottom>
                  <Button fx:id="saveButton" managed="false" mnemonicParsing="false" onAction="#onSaveClick" text="Save txt" visible="false" BorderPane.alignment="CENTER_RIGHT">
                     <BorderPane.margin>
                        <Insets bottom="10.0" right="20.0" />
                     </BorderPane.margin>
                  </Button>
               </bottom>

               <center>
                  <ScrollPane fx:id="reportScroll" fitToHeight="false" fitToWidth="true" hbarPolicy="NEVER" managed="false" styleClass="report-scroll" vbarPolicy="AS_NEEDED" visible="false" BorderPane.alignment="CENTER">

                     <content>
                        <VBox fx:id="reportContainer" fillWidth="true" spacing="10.0">
                           <padding>
                              <Insets bottom="10.0" />
                           </padding>
                        </VBox>
                     </content>

                     <BorderPane.margin>
                        <Insets bottom="10.0" left="40.0" right="40.0" top="15.0" />
                     </BorderPane.margin>
                  </ScrollPane>
               </center>

            </BorderPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
