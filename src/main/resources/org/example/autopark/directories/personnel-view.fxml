<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.autopark.client.directoriesControllers.PersonnelViewController">

    <top>
          <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" prefHeight="37.0" prefWidth="600.0" text="Personnel" textAlignment="CENTER" textFill="#007641" BorderPane.alignment="CENTER">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
      </top>
      <center>
         <TableView fx:id="personnelTable"
                    BorderPane.alignment="CENTER"
                    maxWidth="Infinity"
                    minWidth="400.0"
                    minHeight="100.0">
           <columns>
             <TableColumn fx:id="idColumn" minWidth="2.0" text="Id" />
             <TableColumn fx:id="nameColumn" text="First name" />
               <TableColumn fx:id="lastNameColumn" text="Last name" />
               <TableColumn fx:id="fatherNameColumn" text="Father name" />
           </columns>
            <BorderPane.margin>
               <Insets left="30.0" right="30.0" top="5.0" />
            </BorderPane.margin>
         </TableView>
      </center>
    <bottom>
        <HBox alignment="CENTER"
              minHeight="70.0"
              prefHeight="70.0"
              spacing="40.0">
            <padding>
                <Insets top="10.0" bottom="20.0" />
            </padding>
            <children>
                <Button fx:id="insertButton"
                        mnemonicParsing="false"
                        onAction="#onInsertClick"
                        minHeight="30.0"
                        prefHeight="30.0"
                        prefWidth="70.0"
                        text="Insert" />

                <Button fx:id="editButton"
                        mnemonicParsing="false"
                        onAction="#onEditClick"
                        minHeight="30.0"
                        prefHeight="30.0"
                        prefWidth="70.0"
                        text="Edit" />

                <Button fx:id="deleteButton"
                        mnemonicParsing="false"
                        onAction="#onDeleteClick"
                        minHeight="30.0"
                        prefHeight="30.0"
                        prefWidth="70.0"
                        text="Delete" />
            </children>
        </HBox>
    </bottom>
   </BorderPane>

