<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.autopark.client.directoriesControllers.PersonnelViewController">

    <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

    <top>
          <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" prefHeight="37.0" prefWidth="600.0" text="Personnel" textAlignment="CENTER" textFill="#007641" BorderPane.alignment="CENTER">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
      </top>
      <center>
         <TableView fx:id="personnelTable" minWidth="500.0" BorderPane.alignment="CENTER">
           <columns>
             <TableColumn fx:id="idColumn" minWidth="2.0" prefWidth="51.99999463558197" text="Id" />
             <TableColumn fx:id="nameColumn" prefWidth="148.80005645751953" text="First name" />
               <TableColumn fx:id="lastNameColumn" prefWidth="172.80006408691406" text="Last name" />
               <TableColumn fx:id="fatherNameColumn" prefWidth="162.39999389648438" text="Father name" />
           </columns>
            <BorderPane.margin>
               <Insets left="30.0" right="30.0" top="5.0" />
            </BorderPane.margin>
         </TableView>
      </center>
      <bottom>
         <HBox alignment="CENTER" prefHeight="70.0" prefWidth="600.0" spacing="40.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="insertButton" mnemonicParsing="false" onAction="#onInsertClick" prefHeight="20.0" prefWidth="70.0" text="Insert" />
                <Button fx:id="editButton" mnemonicParsing="false" onAction="#onEditClick" prefHeight="20.0" prefWidth="70.0" text="Edit" />
                <Button fx:id="deleteButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onDeleteClick" prefHeight="20.0" prefWidth="70.0" text="Delete" />
            </children>
         </HBox>
      </bottom>
   </BorderPane>

</AnchorPane>
