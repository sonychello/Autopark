<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.autopark.client.directoriesControllers.CarsViewController">

    <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <top>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" prefHeight="37.0" prefWidth="600.0" text="Cars" textAlignment="CENTER" textFill="#007641" BorderPane.alignment="CENTER">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </top>
        <center>
            <TableView fx:id="carsTable" minWidth="500.0" BorderPane.alignment="CENTER">
                <columns>
                    <TableColumn fx:id="idColumn" text="Id" />
                    <TableColumn fx:id="numberColumn" text="Number" />
                    <TableColumn fx:id="colorColumn" text="Color" />
                    <TableColumn fx:id="markColumn" text="Mark" />
                    <TableColumn fx:id="personnelIdColumn" text="Personnel_id" />
                </columns>
                <BorderPane.margin>
                    <Insets left="30.0" right="30.0" top="5.0" />
                </BorderPane.margin>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
        </center>
        <bottom>
            <HBox alignment="CENTER" prefHeight="70.0" prefWidth="600.0" spacing="40.0" BorderPane.alignment="CENTER">
                <children>
                    <Button fx:id="insertButton" mnemonicParsing="false" onAction="#onInsertClick" prefHeight="20.0" prefWidth="70.0" text="Insert" />
                    <Button fx:id="editButton" mnemonicParsing="false" onAction="#onEditClick" prefHeight="20.0" prefWidth="70.0" text="Edit" />
                    <Button fx:id="deleteButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onDeleteClick" prefHeight="20.0" prefWidth="70.0" text="Delete" />
                </children>
            </HBox>
        </bottom>
    </BorderPane>

</AnchorPane>
