<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.autopark.client.directoriesControllers.CarsViewController">

        <top>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" prefHeight="37.0" prefWidth="600.0" text="Cars" textAlignment="CENTER" textFill="#007641" BorderPane.alignment="CENTER">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </top>
        <center>
            <TableView fx:id="carsTable"
                       BorderPane.alignment="CENTER"
                       maxWidth="Infinity"
                       minWidth="500.0"
                       minHeight="100.0">
                <columns>
                    <TableColumn fx:id="idColumn" text="Id" />
                    <TableColumn fx:id="numberColumn" text="Number" />
                    <TableColumn fx:id="colorColumn" text="Color" />
                    <TableColumn fx:id="markColumn" text="Mark" />
                    <TableColumn fx:id="personnelIdColumn" text="Personnel_id" />
                </columns>
                <BorderPane.margin>
                    <Insets left="30.0" right="30.0" top="5.0" bottom="15.0" />
                </BorderPane.margin>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
        </center>
    <bottom>
        <HBox fx:id="buttonsBox"
              alignment="CENTER"
              minHeight="70.0"
              prefHeight="70.0"
              spacing="40.0">
            <padding>
                <Insets top="10.0" bottom="20.0" />
            </padding>
            <children>
                <Button fx:id="insertButton"
                        mnemonicParsing="false"
                        onAction="#onInsertClick"
                        minHeight="30.0"
                        prefHeight="30.0"
                        prefWidth="70.0"
                        text="Insert" />

                <Button fx:id="editButton"
                        mnemonicParsing="false"
                        onAction="#onEditClick"
                        minHeight="30.0"
                        prefHeight="30.0"
                        prefWidth="70.0"
                        text="Edit" />

                <Button fx:id="deleteButton"
                        mnemonicParsing="false"
                        onAction="#onDeleteClick"
                        minHeight="30.0"
                        prefHeight="30.0"
                        prefWidth="70.0"
                        text="Delete" />
            </children>
        </HBox>
    </bottom>
    </BorderPane>
