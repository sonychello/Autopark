<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="348.0" stylesheets="@css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.autopark.client.AuthViewController">
   <children>
      <VBox fx:id="authorizationContainer"
            alignment="CENTER"
            spacing="20.0"
            minWidth="300.0"
            minHeight="350.0"
            maxWidth="500.0"
            maxHeight="550.0"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="35.0" prefWidth="155.0" text="Authorization" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <VBox alignment="CENTER"
                  maxHeight="-Infinity"
                  maxWidth="400.0"
                  prefHeight="199.0"
                  prefWidth="150.0"
                  spacing="20.0">
               <padding>
                  <Insets left="30.0" right="30.0"/>
               </padding>
               <children>
                  <Label text="Nick Name">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="inputNickName" />
                  <Label text="Password">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="inputPassword" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#onLoginClick" text="Log in">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <Label fx:id="logInInformation"
                   alignment="TOP_CENTER"
                   contentDisplay="TOP">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
